# Copy to .env on the droplet and edit values.
# DO NOT commit real secrets.

# Public URL clients use (your droplet IP or domain)
PUBLIC_BASE_URL=http://168.144.158.115

# Shared API key for POST /api/v1/urls and GET /api/v1/urls/{code}
API_KEY=change-me-to-a-long-random-secret

# Optional cache TTL (seconds)
CACHE_TTL_SECONDS=3600
